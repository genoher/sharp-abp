<Project>
	<PropertyGroup>
		<!--Project Frameworks-->
		<ProjectFrameworks>netstandard2.0;netstandard2.1;$(NetCoreFx)</ProjectFrameworks>
		<!--Net Core Framework-->
		<NetCoreFx>net8.0</NetCoreFx>
		<!--Microsoft-->
		<MicrosoftMiniumPackageVersion>[8.0.0,)</MicrosoftMiniumPackageVersion>
		<MicrosoftPackageVersion>[8.0.24,)</MicrosoftPackageVersion>
		<!--EfCore-->
		<EfCorePackageVersion>[8.0.24,)</EfCorePackageVersion>
		<!--Volo ABP packages-->
		<VoloAbpPackageVersion>[8.3.4,)</VoloAbpPackageVersion>
		<!--FreeSql package-->
		<FreeSqlPackageVersion>[3.5.306,)</FreeSqlPackageVersion>
		<!--Masstransit package-->
		<MassTransitPackageVersion>[8.5.8,)</MassTransitPackageVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IsTestProject Condition="$(MSBuildProjectFullPath.Contains('test')) and ($(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.TestBase')))">true</IsTestProject>
	</PropertyGroup>

</Project>